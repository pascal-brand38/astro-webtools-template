---
// Copyright (c) Pascal Brand
// MIT License
// part of AWT (astro-webtools-template)
//
// Add a menu with pure CSS
// Makes use of

/* Example usage:
  <NavBarPureCss />

*/

import { langFromAstroUrlPathname } from '@AWT/ts/languages.ts';
import type { Config } from '@AWT/ts/types.ts';
import configUntyped from '@src/config/config.json' with { type: 'json' };
const config: Config = configUntyped as Config;

const lang = langFromAstroUrlPathname(Astro.url.pathname);

---

{ (config.navPages) &&
<nav class="[ awt-container awt-nav__container ] awt-nav-purecss">
  <div>
    <span class="logo awt-show-hamburger-only">Menu</span>
    <input class="menu-btn" type="checkbox" id="menu-btn" />
    <label class="menu-icon" for="menu-btn"><span class="navicon"></span></label>
    <ul class="menu">
      {
        config.navPages.map((nav) => (
          <li>
            <a href={nav[lang].url}> {nav[lang].alt} </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
}

<style>

/* navigation menu
  - no margin as the menu may be sticked to the header or to some other parts
  - no padding as the menu is sticked to the border on small screen
*/
.awt-nav__container {
  margin-top: 0;
  margin-bottom: 0;

  padding: 0;

  font-size: 1.2rem;
  font-weight: bold;
}

/*****************************************************************
* MENU PURECSS
* From https://codepen.io/mutedblues/pen/MmPNPG
*
* To be used with <nav class="awt-nav-purecss">
*****************************************************************/

nav.awt-nav-purecss {
  /* line, not in the menu */
  z-index: 3; /* have the menu in front of the image in galerie-photos */
  position: relative;
  width: 100%;

  height: 28px;
  line-height: 28px;
  background-color: var(--awt-bg-color-2);
}

/* line on the menu, where the buttons are*/
.awt-nav-purecss ul {
  margin: 0;
  padding: 0;
  list-style: none;
  overflow: hidden;
  background-color: var(--awt-bg-color-2);
}

/* each "button" on the menu. This is the same for the printed menu and for the hamburger menu */
nav.awt-nav-purecss li a {
  display: block;
  /* to add a border at each button:    border-right: 1px solid #f4f4f4; */
  color: inherit; /* color: inherit; otherwise, color for links are used, that is Blue */
  text-decoration: none;
  padding: 0px 10px 0px 10px;
  z-index: 3;
}

@media only screen and (max-width: 600px) {
  nav.awt-nav-purecss li a {
    padding: 0px 20px 0px 20px;
  }
}
@media only screen and (min-width: 830px) {
  nav.awt-nav-purecss li a {
    padding: 0px 20px 0px 20px;
  }
}
nav.awt-nav-purecss li:last-child a {
  padding-right: 20px; /* if the last is too small, the scroller is ont top of it */
}

/* color of the "button" when we are hover */
nav.awt-nav-purecss li a:hover,
nav.awt-nav-purecss .menu-btn:hover {
  background-color: var(--awt-bg-color-3);
}

/* Position of the logo */
nav.awt-nav-purecss .logo {
  display: block;
  float: left;
  text-decoration: none;
  padding: 0;
  margin-left: 20px;
}

/* menu
- navicon are the 3bars of the hamburger that are spanned
  there is a transition to transform them in a cross when we click on it
- menu-icon is related to the span
- menu-btn is a checkbox button, to correctly display the hamburger
*/
nav.awt-nav-purecss .menu {
  clear: both;
  max-height: 0;
  transition: max-height 0.2s ease-out;
}

/* menu icon */

nav.awt-nav-purecss .menu-icon {
  cursor: pointer;
  display: inline-block;
  float: left;
  padding: 13px 20px; /* 13 as awt-nav-purecss height is 28px, and heigh of navicon is 2px (13+13+2=28).
                          20px for sufficient space */
  position: relative;
  user-select: none;
}

nav.awt-nav-purecss .menu-icon .navicon {
  background: #333;
  display: block;
  height: 2px;
  position: relative;
  transition: background 0.2s ease-out;
  width: 18px;
}

nav.awt-nav-purecss .menu-icon .navicon:before,
nav.awt-nav-purecss .menu-icon .navicon:after {
  background: #333;
  content: '';
  display: block;
  height: 100%;
  position: absolute;
  transition: all 0.2s ease-out;
  width: 100%;
}

nav.awt-nav-purecss .menu-icon .navicon:before {
  top: 5px;
}

nav.awt-nav-purecss .menu-icon .navicon:after {
  top: -5px;
}

/* menu btn */

nav.awt-nav-purecss .menu-btn {
  display: none;
}

nav.awt-nav-purecss .menu-btn:checked ~ .menu {
  max-height: 240px;
}

nav.awt-nav-purecss .menu-btn:checked ~ .menu-icon .navicon {
  background: transparent;
}

nav.awt-nav-purecss .menu-btn:checked ~ .menu-icon .navicon:before {
  transform: rotate(-45deg);
}

nav.awt-nav-purecss .menu-btn:checked ~ .menu-icon .navicon:after {
  transform: rotate(45deg);
}

nav.awt-nav-purecss .menu-btn:checked ~ .menu-icon:not(.steps) .navicon:before,
nav.awt-nav-purecss .menu-btn:checked ~ .menu-icon:not(.steps) .navicon:after {
  top: 0;
}

@media (min-width: 601px) {
  /* here, the menu is NOT an hamburger */
  nav.awt-nav-purecss li {
    float: left;
  }
  nav.awt-nav-purecss .menu {
    clear: none;
    float: right;
    max-height: none;
  }
  nav.awt-nav-purecss .menu-icon {
    display: none;
  }

  nav.awt-nav-purecss .awt-show-hamburger-only {
    display: none !important;
  }
}
</style>
