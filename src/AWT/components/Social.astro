---
// Copyright (c) Pascal Brand
// MIT License
// part of AWT (astro-webtools-template)
//
// Add a single social icon. Used by Socials

// https://github.com/natemoo-re/astro-icon#readme
// https://icon-sets.iconify.design/
// packages that can be used: https://www.npmjs.com/search?q=iconify-json
//
// mdi: Material Design Icons - https://icon-sets.iconify.design/mdi/
//     pnpm add @iconify-json/mdi
// bxl: Boxicons Brands - https://icon-sets.iconify.design/bxl/
//     pnpm add @iconify-json/bxl

import { Icon } from 'astro-icon/components'
import type { SocialName } from '@AWT/ts/types'

interface Socials {
  [name: string]: {
    [shape: string]: {
      icon: string
      color: string
      size: number
    }
  }
}

// list socials that are supported.
// color come from https://materialui.co/socialcolors
const socials: Socials = {
  facebook: {
    circle: {
      icon: 'mdi:facebook',
      color: '#1877F2',
      size: 38,
    },
    square: {
      icon: 'bxl:facebook-square',
      color: '#3b5998',
      size: 44,
    },
  },
  youtube: {
    circle: {
      icon: 'mdi:youtube',
      color: '#CD201F',
      size: 38,
    },
    square: {
      icon: 'mdi:youtube',
      color: '#CD201F',
      size: 38,
    },
  },
}

interface Props {
  name: SocialName
  shape?: 'circle' | 'square'
  color?: string
  size?: number
  href: string
}

const { name, shape = 'circle', color = undefined, size, href } = Astro.props
---

<a
  href={href}
  aria-label={name}
  target="_blank"
  rel="noopener noreferrer">

  <Icon
    name={socials[name][shape].icon}
    size={ size ?? socials[name][shape].size}
    color={color ?? socials[name][shape].color}
    />

</a>

<style>
svg {
  /* align the svg vertically */
  display: inline-block;
  vertical-align: middle;
}

a {
  text-decoration: none;
}
</style>